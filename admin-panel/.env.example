# Must match frontend/.env ADMIN_API_KEY (REQUIRED in production)
ADMIN_API_KEY="change-this-admin-api-key-in-production"

# Main public site URL (REQUIRED in production)
MAIN_SITE_URL="http://localhost:3000"

# Staff login (REQUIRED in production — use a strong password)
ADMIN_PANEL_PASSWORD="change-this-admin-panel-password"

# Cookie signing secret (REQUIRED in production)
ADMIN_PANEL_SECRET="change-this-panel-secret-in-production"
